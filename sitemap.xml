---
layout: null
---
{%- comment -%}
  Sitemap for search engines. Every page with a sitemap value is added
  automatically, and each language version lists its counterparts.
{%- endcomment -%}
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:xhtml="http://www.w3.org/1999/xhtml">
{%- assign _pages = site.pages | where_exp: "p", "p.sitemap" %}
{%- for _language in site.data.languages %}
  {%- for p in _pages %}
    {%- if p.lang == _language.code %}
      {%- assign _alts = _pages | where: "ref", p.ref %}
  <url>
    <loc>{{ site.url }}{{ p.url | replace: '.html', '' }}</loc>
    <lastmod>{{ p.sitemap.lastmod | date: "%Y-%m-%d" }}</lastmod>
    <changefreq>{{ p.sitemap.changefreq }}</changefreq>
    <priority>{{ p.sitemap.priority }}</priority>
      {%- if _alts.size > 1 %}
        {%- for _l in site.data.languages %}
          {%- assign _alt = _alts | where: "lang", _l.code | first %}
          {%- if _alt %}
    <xhtml:link rel="alternate" hreflang="{{ _l.code }}" href="{{ site.url }}{{ _alt.url | replace: '.html', '' }}"/>
          {%- endif %}
        {%- endfor %}
      {%- endif %}
  </url>
    {%- endif %}
  {%- endfor %}
{%- endfor %}
</urlset>
